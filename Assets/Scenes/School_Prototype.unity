  m_Script: {fileID: 11500000, guid: 93c7f8527e28f564b87bf01321201238, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ItemPickup
  itemId: phone_sato
  displayName: "\u4F50\u85E4\u306E\u30B9\u30DE\u30FC\u30C8\u30D5\u30A9\u30F3"
  description: "\u3055\u3063\u304D\u307E\u3067\u8A71\u3057\u3066\u3044\u305F\u4F50\u85E4\u306E\u3082\u306E\u3060\u3002\u753B\u9762\u304C\u3064\u3044\u305F\u307E\u307E\u306B\u306A\u3063\u3066\u3044\u308B\u3002"
  readText: "\uFF3B2\u5E743\u7D44 \u7537\u5B50\uFF3D\n\n\u4F50\u85E4\uFF1A\u660E\u65E5\u3042\u3044\u3064\u306E\u673A\u3069\u3046\u3059\u308B\uFF1F\n\u5C71\u672C\uFF1A\u307E\u305F\u96E2\u3057\u3068\u3053\u3046\u305C\n\u4F50\u85E4\uFF1A\u9AD8\u6A4B\u3082\u305D\u308C\u3067\u3044\u3044\u3088\u306A\n\u9AD8\u6A4B\uFF1A\u307E\u3042\u3001\u3044\u3044\u3093\u3058\u3083\u306D\n\n\u2015\u2015\u76F8\u6CA2 \u60A0 \u306F\u3053\u306E\u30B0\u30EB\u30FC\u30D7\u306B\u53C2\u52A0\u3057\u3066\u3044\u307E\u305B\u3093\n\n\u2015\u2015\u4ECA\u65E5 16:46\u2015\u2015\n\u5C71\u672C \u304C\u30B0\u30EB\u30FC\u30D7\u3092\u9000\u51FA\u3057\u307E\u3057\u305F\n\u4F50\u85E4\uFF1A\u304A\u3044\u5C71\u672C\uFF1F\u3069\u3053\u884C\u3063\u305F\n\u4F50\u85E4\uFF1A\u673A\u304C\n\u4F50\u85E4 \u304C\u30B0\u30EB\u30FC\u30D7\u3092\u9000\u51FA\u3057\u307E\u3057\u305F"
  afterMessage: "\uFF08\u2026\u2026\u9000\u51FA\uFF1F\u3000\u3055\u3063\u304D\u307E\u3067\u3001\u3053\u3053\u306B\u3044\u305F\u306E\u306B\uFF09"
